<%- include('partials/head') %>
<h1>Bài tập trắc nghiệm</h1>
<p>Giáo viên tạo bài tập trắc nghiệm một đáp án, gửi link cho học sinh và xem điểm ngay khi các em nộp bài.</p>

<form method="get" action="/join" class="card form join">
  <label>Học sinh: nhập mã bài tập thầy cô đã cho
    <input name="code" class="code-input" value="<%= codeInput %>" required maxlength="200"
           autocomplete="off" autocapitalize="characters" spellcheck="false" placeholder="Ví dụ: ABC234">
  </label>
  <% if (codeError) { %><p class="error" role="alert"><%= codeError %></p><% } %>
  <button type="submit">Mở bài tập</button>
</form>

<h2>Học theo lớp</h2>
<ul class="tiles">
  <% for (const grade of grades) { %>
    <li><a class="tile card" href="/lop/<%= grade %>">Lớp <%= grade %></a></li>
  <% } %>
</ul>

<h2>Giáo viên</h2>
<% if (locals.teacher) { %>
  <p><a class="button" href="/teacher">Vào trang bài tập của tôi</a></p>
<% } else { %>
  <p>
    <a class="button" href="/register">Đăng ký tài khoản giáo viên</a>
    <a class="button secondary" href="/login">Đăng nhập</a>
  </p>
<% } %>
<%- include('partials/foot') %>
