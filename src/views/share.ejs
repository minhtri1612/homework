<%- include('partials/head') %>
<h1><%= homework.title %></h1>
<section class="card">
  <p>Giáo viên: <strong><%= homework.teacherName %></strong></p>
  <p><%= homework.questionCount %> câu hỏi trắc nghiệm, mỗi câu chọn một đáp án.</p>
  <% if (homework.deadline) { %>
    <p>Hạn nộp: <strong><%= formatDateTime(homework.deadline) %></strong> (giờ Việt Nam)</p>
  <% } else { %>
    <p class="muted">Không có hạn nộp.</p>
  <% } %>
  <% if (homework.timeLimitMinutes) { %>
    <p>Thời gian làm bài: <strong><%= homework.timeLimitMinutes %> phút</strong></p>
  <% } %>
  <p class="muted">Mã bài tập: <code><%= homework.shareCode %></code></p>
</section>
<% if (notice) { %>
  <p class="notice danger" role="alert"><%= notice %></p>
<% } %>
<% if (previous) { %>
  <p class="notice success">Trên máy này, <strong><%= previous.name %></strong> đã nộp bài. <a href="<%= previous.url %>">Xem kết quả</a></p>
<% } %>
<% if (closed) { %>
  <p class="notice danger" role="status">Đã hết hạn nộp bài.</p>
<% } else { %>
  <% if (homework.timeLimitMinutes) { %>
    <form method="post" action="/h/<%= homework.shareCode %>/start" class="card form">
  <% } else { %>
    <form method="get" action="/h/<%= homework.shareCode %>/answer" class="card form">
  <% } %>
    <label>Họ và tên của em
      <input name="name" value="<%= nameInput %>" autocomplete="name" required maxlength="100" autofocus
             <% if (nameError) { %>aria-invalid="true" aria-describedby="name-error"<% } %>>
    </label>
    <% if (nameError) { %><p class="error" id="name-error"><%= nameError %></p><% } %>
    <p class="muted">Mỗi tên chỉ được nộp bài một lần. Ghi đầy đủ họ tên để thầy cô nhận ra em.</p>
    <% if (homework.timeLimitMinutes) { %>
      <p class="notice">Đồng hồ <strong><%= homework.timeLimitMinutes %> phút</strong> bắt đầu chạy khi em bấm “Bắt đầu làm bài”
        và không dừng lại, kể cả khi tải lại trang hay đổi máy. Hết giờ, bài làm sẽ tự động được nộp.</p>
    <% } %>
    <button type="submit">Bắt đầu làm bài</button>
  </form>
<% } %>
<%- include('partials/foot') %>
