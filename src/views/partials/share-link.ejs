<%# The full link for students, with a copy button (needs /js/copy.js). Pass url. %>
<div class="share-link">
  <input value="<%= url %>" readonly aria-label="Link cho học sinh">
  <button type="button" class="small secondary" data-copy hidden>Sao chép link</button>
  <a href="<%= url %>" target="_blank" rel="noopener">Xem trang học sinh</a>
</div>
