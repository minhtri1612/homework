{
  "name": "homework",
  "version": "0.1.0",
  "description": "Website bài tập trắc nghiệm một đáp án cho giáo viên và học sinh",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "pretest": "prisma generate && npm run typecheck",
    "test": "node --test \"test/**/*.test.js\"",
    "typecheck": "tsc -p .",
    "postinstall": "prisma generate",
    "parse": "node scripts/parse.js",
    "db:init": "node scripts/db-migrate.js",
    "db:reset": "node scripts/db-reset.js",
    "db:seed": "node scripts/db-seed.js",
    "db:generate": "prisma generate",
    "db:migration": "node scripts/db-new-migration.js",
    "dev": "node --watch src/server.ts",
    "start": "node src/server.ts"
  },
  "dependencies": {
    "@libsql/client": "0.17.4",
    "@prisma/adapter-libsql": "7.10.1",
    "@prisma/client": "7.10.1",
    "ejs": "7.0.1",
    "express": "5.3.0",
    "prisma": "7.10.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  }
}
